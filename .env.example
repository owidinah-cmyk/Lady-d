# === POSTGRES (Neon) ===
# Get this from https://console.neon.tech after creating a free project.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Cloudinary (admin image uploads)
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_UPLOAD_PRESET are used server-side.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is used in the browser for direct
# unsigned uploads from the admin panel.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Brevo (transactional email)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Lady D Kitchen Catering Services"

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_BUSINESS_NAME="Lady D Kitchen"

# === AUTH SECRET ===
# Used for signing cart cookies and other HMAC operations.
# Generate a random 32+ char string in production. Vercel sets
# this automatically when you deploy, but for local dev you'll
# need to set it manually.
AUTH_SECRET=""

# === GOOGLE OAUTH ===
# Create a project at https://console.cloud.google.com/
# Enable the People API / Google+ API, create OAuth 2.0
# credentials (Web application), and set redirect URIs to:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
#   {NEXT_PUBLIC_SITE_URL}/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
